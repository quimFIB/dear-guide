#!/usr/bin/env bash
# Record every `dg-agent` invocation, then delegate. `dg`'s sibling, and the
# same mechanism: it is NAMED `dg-agent` and lives in the same directory, so
# putting that directory first on $PATH routes both binaries through a wrapper.
#
#     export PATH="/path/to/dear-guide/agentic/bin:$PATH"
#     command -v dg-agent    # should print .../agentic/bin/dg-agent
#     dg-agent list          # ...and it is recorded
#
# WHY THERE ARE TWO. The launcher split out of `dg` into `dg-agent`, and most
# of what a capture of a *fan-out* is for went with it: the claims, the setup,
# the launch, the parks. A capture that wrapped only `dg` would record the
# proposals and lose every act that produced them, while looking complete.
#
# The directory holds these two and nothing else, so putting it first shadows
# `dg` and `dg-agent` and nothing else on the system. Both write the same log,
# in one stream, because the interleaving is the thing worth having: a park
# staged by `dg-agent run` and the `dg pending` that read it are one story.
#
# THIS IS OPTIONAL. Running a fan-out does not need it -- see agentic/README.md,
# which is the procedure; this is for when you want the RUN ITSELF afterwards.
# It was written so that one real session could become a demo, and it is equally
# useful for auditing what a set of agents actually proposed. A fan-out with the
# capture off leaves behind exactly what it decided, which is the point of the
# graph.
#
# WHY IT HAS TO EXIST AT ALL, given that. The graph keeps what LANDED and
# deliberately not what was proposed: `dg drop`, `dg clear --agent` and an applied tray all erase what was
# there, because a record of every draft somebody thought better of is not a
# record of a project's decisions. That is the right call for the store and the
# wrong one for watching a fan-out work, where the proposals nobody took are
# most of what there is to see.
#
# So this writes a second, disposable record beside the durable one. It is not
# part of the graph, nothing reads it back, and deleting it loses nothing the
# project needs.
#
# WHAT IT RECORDS. One JSON object per invocation: when, which agent, the
# argv, the exit code, stdout and stderr, and BOTH TRAYS AS THEY STOOD
# AFTERWARDS. That last field is the point -- a dropped op is visible as the
# difference between one entry's tray and the next one's, so the op that never
# reached the graph is still in the log, in full.
#
# WHAT IT CANNOT SEE, and you should decide before the run rather than after:
#
#   * The browser. `dg serve` runs its own process and does not come through
#     here, so a review done by clicking leaves no entry. Either do the recorded
#     review in the terminal, or accept the gap and say so in the narration --
#     but do not half-do it, because the step where somebody turned a proposal
#     down is the part of the record that matters most.
#   * Reasoning, and anything that is not a `dg` call. Whatever host ran the
#     agent keeps that, wherever it keeps it -- Claude Code writes one JSONL per
#     session under ~/.claude/projects/<slug>/, opencode its own store. Copy
#     them at the end; nothing else holds them. This wrapper is host-neutral for
#     the same reason the workflow is: it wraps the CLI, not the agent.
#
set -uo pipefail

# --- find the real dg-agent ------------------------------------------------
#
# The first `dg-agent` on $PATH that is not this one. Resolved rather than
# hardcoded, so the script works from a venv, a pipx install or a checkout
# without being edited -- and $DG_AGENT_REAL overrides it for the case none of
# those is true.
_self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL="${DG_AGENT_REAL:-}"
if [ -z "$REAL" ]; then
  IFS=: read -ra _dirs <<< "$PATH"
  for _d in "${_dirs[@]}"; do
    [ -n "$_d" ] || continue
    [ "$(cd "$_d" 2>/dev/null && pwd)" = "$_self" ] && continue
    if [ -x "$_d/dg-agent" ]; then REAL="$_d/dg-agent"; break; fi
  done
fi
if [ -z "$REAL" ]; then
  echo "capture: no real \`dg-agent\` on \$PATH besides this wrapper" >&2
  echo "         set \$DG_AGENT_REAL to it, or install dear-guide" >&2
  exit 127
fi

# --- where the record goes -------------------------------------------------
#
# `.dgraph-capture/` by default, which the .gitignore `dg init` writes already
# covers under `.dgraph-*` -- so a capture never has to be remembered about at
# commit time.
LOG_DIR="${DG_CAPTURE:-$PWD/.dgraph-capture}"
LOG="$LOG_DIR/dg.jsonl"

# --- interactive and long-running commands pass straight through -----------
#
# `setup` without flags is a full-screen form, and `run` is the parent of an
# agent that may run for half an hour and whose stdout is the agent's own.
# Buffering either through a pipe breaks it -- `run` would hold the whole
# session's output and hand it over at the end, which is not a launcher.
#
# THE COST, SAID OUT LOUD: `dg-agent run` is therefore absent from the log. The
# `dg` calls its child makes are all captured, which is the record of what the
# agent did; what is lost is the launch line itself, and `fanout/env.json` and
# `fanout/launch.sh` are both on disk and say it.
case " $* " in
  *" run "*|*" setup "*) exec "$REAL" "$@" ;;
esac

out="$(mktemp)"; err="$(mktemp)"
"$REAL" "$@" >"$out" 2>"$err"; rc=$?

# Output first, and unmodified. `dg-agent claim` prints a bare name precisely
# so `DG_AGENT=$(dg-agent claim)` works; a wrapper that prepended a banner
# would break every launch that used it.
cat "$out"; cat "$err" >&2

python3 - "$rc" "$out" "$err" "$LOG" "$@" <<'PY'
import datetime
import json
import os
import sys

rc, out, err, log, *argv = sys.argv[1:]


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


os.makedirs(os.path.dirname(log), exist_ok=True)
with open(log, "a", encoding="utf-8") as f:
    f.write(json.dumps({
        "at": datetime.datetime.now().isoformat(timespec="seconds"),
        "agent": os.environ.get("DG_AGENT"),
        "cwd": os.getcwd(),
        "argv": argv,
        "exit": int(rc),
        "stdout": read(out),
        "stderr": read(err),
        # The trays AFTER the call. An op that was dropped is the difference
        # between this entry and the one before it, which is the only place it
        # survives at all.
        "tray": read(os.path.join(os.getcwd(), ".dgraph-pending.json")),
        "task_tray": read(os.path.join(os.getcwd(),
                                       ".dgraph-task-pending.json")),
    }, ensure_ascii=False) + "\n")
PY

rm -f "$out" "$err"
exit "$rc"
